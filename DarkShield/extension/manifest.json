{
	"manifest_version": 3,
	"name": "Behavior Analyzer",
	"version": "1.0",
	"description": "Collects non-sensitive interaction metadata for behavior analysis.",
	"permissions": [
		"storage",
		"activeTab"
	],
	"host_permissions": [
		"http://localhost/*",
		"https://localhost/*",
		"http://127.0.0.1/*",
		"https://127.0.0.1/*"
	],
	"content_scripts": [
		{
			"matches": [
				"<all_urls>"
			],
			"js": [
				"content.js"
			],
			"run_at": "document_start"
		}
	],
	"background": {
		"service_worker": "background.js"
	},
	"action": {
		"default_title": "Behavior Analyzer",
		"default_popup": "popup/popup.html"
	}
}
